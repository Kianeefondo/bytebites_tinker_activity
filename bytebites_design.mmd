classDiagram
    class Customer {
        -name: str
        -purchaseHistory: List[Item]
        +Customer(name: str)
        +getName() str
        +addPurchase(item: Item) void
        +getPurchaseHistory() List[Item]
    }

    class Item {
        -name: str
        -price: float
        -category: Category
        -popularityRating: float
        +Item(name: str, price: float, category: Category, popularityRating: float)
        +getName() str
        +getPrice() float
        +getCategory() Category
        +getPopularityRating() float
    }

    class Category {
        -name: str
        -items: List[Item]
        +Category(name: str)
        +getName() str
        +addItem(item: Item) void
        +getItems() List[Item]
        +filterItems() List[Item]
    }

    class Transaction {
        -items: List[Item]
        +Transaction()
        +addItem(item: Item) void
        +getItems() List[Item]
        +calculateTotal() float
    }

    Customer "1" --> "0..*" Item : purchaseHistory
    Category "1" --> "0..*" Item : contains
    Item --> "1" Category : belongsTo
    Transaction "1" --> "1..*" Item : contains